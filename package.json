{
  "name": "cattus-screentime",
  "version": "0.1.0",
  "description": "React Native module for measuring app screen time on iOS (Family Controls) and Android (Usage Access)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "jest",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "typecheck": "tsc --noEmit",
    "check:extension": "node scripts/check-extension-copy.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "screen-time",
    "family-controls",
    "device-activity",
    "usage-stats"
  ],
  "repository": "https://github.com/OneOrThree/cattus-screentime",
  "bugs": {
    "url": "https://github.com/OneOrThree/cattus-screentime/issues"
  },
  "author": "OneOrThree (https://github.com/OneOrThree)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OneOrThree/cattus-screentime#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.32",
    "jest": "^29.7.0",
    "jest-expo": "57.0.2",
    "prettier": "^3.0.0",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "globalSetup": "<rootDir>/jest.globalSetup.js"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "ios-extension",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json",
    "NOTICE"
  ]
}
