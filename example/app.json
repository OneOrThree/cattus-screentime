{
  "expo": {
    "name": "CattusScreenTime Example",
    "slug": "cattus-screentime-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oneorthree.cattus.screentime.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oneorthree.cattus.screentime.example"
    },
    "plugins": [
      [
        "../app.plugin.js",
        {
          "appGroup": "group.com.oneorthree.cattus.screentime.example"
        }
      ],
      "@bacons/apple-targets"
    ]
  }
}
